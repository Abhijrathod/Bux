# Auto detect text files and perform LF normalization
* text=auto

# Rust files
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary

# Archives
*.zip binary
*.tar binary
*.gz binary

